/* =========================================================
   倒计时
========================================================= */

function updateCountdown() {

    const now =
        Date.now();


    const next =
        countdownEvents.find(
            function(event) {

                return (
                    new Date(
                        event.time
                    ).getTime()
                    >
                    now
                );

            }
        );


    if (!next) {

        document.getElementById(
            "nextTitle"
        ).textContent =
            "行程已结束";

        return;

    }


    const target =
        new Date(
            next.time
        ).getTime();


    let difference =
        target - now;


    let totalSeconds =
        Math.floor(
            difference / 1000
        );


    const days =
        Math.floor(
            totalSeconds / 86400
        );


    totalSeconds %= 86400;


    const hours =
        Math.floor(
            totalSeconds / 3600
        );


    totalSeconds %= 3600;


    const minutes =
        Math.floor(
            totalSeconds / 60
        );


    const seconds =
        totalSeconds % 60;


    document.getElementById(
        "nextTitle"
    ).textContent =
        next.title;


    document.getElementById(
        "nextTime"
    ).textContent =
        "出发时间："
        +
        new Date(
            next.time
        ).toLocaleString(
            "zh-CN",
            {
                timeZoneName:
                    "short"
            }
        );


    document.getElementById(
        "days"
    ).textContent =
        String(days)
        .padStart(2,"0");


    document.getElementById(
        "hours"
    ).textContent =
        String(hours)
        .padStart(2,"0");


    document.getElementById(
        "minutes"
    ).textContent =
        String(minutes)
        .padStart(2,"0");


    document.getElementById(
        "seconds"
    ).textContent =
        String(seconds)
        .padStart(2,"0");

}


updateCountdown();

setInterval(
    updateCountdown,
    1000
);

</script>

</body>
</html>
