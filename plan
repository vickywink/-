========================================================= */

function createNoteHTML(note) {

    if (
        !note ||
        note.length === 0
    ) {

        return "";

    }


    return `

    <div class="note">

        <div class="note-title">
            📝 备注
        </div>

        <ul>

            ${note.map(
                function(item) {

                    return `
                    <li>
                        ${item}
                    </li>
                    `;

                }
            ).join("")}

        </ul>

    </div>

    `;

}


/* =========================================================
   渲染每日行程
========================================================= */

function renderItinerary() {

    const root =
        document.getElementById(
            "days"
        );


    root.innerHTML =
        itinerary.map(
            function(day) {


                const activities =
                    day.items
                    .map(
                        createActivityHTML
                    )
                    .join("");


                const hotel =
                    createHotelHTML(
                        day.id
                    );


                const note =
                    createNoteHTML(
                        day.note
                    );


                const route =
                    day.route
                    .split(" → ")
                    .map(
                        function(
                            location,
                            index
                        ) {

                            return (

                                index > 0
                                ?

                                `
                                <span class="route-arrow">
                                    →
                                </span>
                                `

                                :

                                ""

                            )

                            +

                            `
                            <span>
                                ${location}
                            </span>
                            `;

                        }
                    )
                    .join("");


                return `

                <section
                    class="card"
                    id="${day.id}"
                >


                    <div
                        class="day-header"
                    >

                        <div>

                            <span
                                class="day-badge"
                            >
                                ${day.id}
                            </span>


                            <div
                                class="day-area"
                            >
                                ${day.area}
                            </div>


                            <div
                                class="day-date"
                            >
                                ${day.date}
                            </div>

                        </div>

                    </div>


                    <div
                        class="route-line"
                    >

                        ${route}

                    </div>


                    <div>

                        ${activities}

                    </div>


                    ${hotel}


                    ${note}


                </section>

                `;

            }
        )
        .join("");

}


