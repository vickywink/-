/* =========================================================
   航班 HTML
========================================================= */

function createFlightHTML(flightNumber) {

    const f =
        flights[flightNumber];

    if (!f) {
        return "";
    }


    return `

    <div class="flight">

        <div class="flight-header">

            <div class="flight-number">
                ${flightNumber}
            </div>

            <div class="flight-status">
                飞常准
            </div>

        </div>


        <div class="flight-route">


            <!-- 出发 -->

            <a
                class="airport"
                href="${googleMaps(
                    f.fromName
                )}"
                target="_blank"
            >

                <strong>
                    ${f.fromCode}
                </strong>

                <span class="airport-name">
                    ${f.fromName}
                </span>

                <span class="airport-terminal">
                    ${f.fromTerminal}
                </span>

            </a>


            <!-- 时间 -->

            <div class="flight-time">

                ${f.departure}

                <span class="flight-time-label">
                    当地时间
                </span>

            </div>


            <!-- 到达 -->

            <a
                class="airport"
                href="${googleMaps(
                    f.toName
                )}"
                target="_blank"
            >

                <strong>
                    ${f.toCode}
                </strong>

                <span class="airport-name">
                    ${f.toName}
                </span>

                <span class="airport-terminal">
                    ${f.toTerminal}
                </span>

            </a>


        </div>


        <div class="flight-arrival">

            到达时间：
            <strong>
                ${f.arrival}
            </strong>

            · ${f.toName}
            ${f.toTerminal}

            <br>

            登机口：
            以出发当天机场实时信息为准

        </div>


        <div class="flight-actions">


            <button
                class="btn"
                onclick="openVariflight('${flightNumber}')"
            >
                ✈ 打开飞常准
            </button>


            <a
                class="btn btn-gray"
                href="${googleMaps(
                    f.fromName
                )}"
                target="_blank"
            >
                出发机场地图
            </a>


            <a
                class="btn btn-gray"
                href="${googleMaps(
                    f.toName
                )}"
                target="_blank"
            >
                到达机场地图
            </a>

        </div>

    </div>

    `;

}


/* =========================================================
   飞常准 App
========================================================= */

function openVariflight(flightNumber) {

    /*
        尝试打开飞常准 App。

        如果手机没有安装，
        约 1.2 秒后跳转 App Store。
    */

    const start =
        Date.now();


    window.location.href =
        "variflight://flight/"
        +
        encodeURIComponent(
            flightNumber
        );


    setTimeout(
        function() {

            if (
                Date.now() - start
                <
                1800
            ) {

                window.location.href =
                    VARIFLIGHT_APP;

            }

        },
        1200
    );

}


