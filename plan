<style>

/* =========================================================
   基础
========================================================= */

:root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --text: #172033;
    --muted: #6b7280;
    --line: #e5e7eb;

    --blue: #5965f2;
    --blue-light: #eef0ff;

    --green: #16a085;
    --green-light: #e9f8f4;

    --orange: #e59b25;
    --orange-light: #fff5df;

    --red: #e25d5d;

    --shadow:
        0 8px 28px rgba(20, 30, 55, 0.07);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;

    background: var(--bg);
    color: var(--text);

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "PingFang SC",
        "Microsoft YaHei",
        sans-serif;

    line-height: 1.55;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
}


/* =========================================================
   页面
========================================================= */

.container {
    max-width: 980px;

    margin: 0 auto;

    padding:
        16px
        14px
        60px;
}


/* =========================================================
   顶部
========================================================= */

.header {
    padding: 8px 2px 18px;
}

.eyebrow {
    font-size: 11px;

    color: var(--muted);

    letter-spacing: 0.12em;

    font-weight: 700;
}

.title {
    margin-top: 4px;

    font-size: 30px;

    font-weight: 900;

    line-height: 1.15;
}

.subtitle {
    margin-top: 7px;

    color: var(--muted);

    font-size: 13px;
}


/* =========================================================
   卡片
========================================================= */

.card {
    background: var(--card);

    border:
        1px solid
        var(--line);

    border-radius: 20px;

    padding: 17px;

    margin: 12px 0;

    box-shadow: var(--shadow);
}


/* =========================================================
   倒计时
========================================================= */

.countdown-card {

    background:
        linear-gradient(
            135deg,
            #111827,
            #29355f
        );

    color: white;

    border: 0;
}

.countdown-card .muted {
    color: #cbd5e1;
}

.next-label {

    font-size: 11px;

    letter-spacing: .08em;

    color: #cbd5e1;
}

.next-title {

    margin-top: 4px;

    font-size: 20px;

    font-weight: 900;
}

.next-time {

    margin-top: 3px;

    color: #cbd5e1;

    font-size: 12px;
}

.countdown {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 7px;

    margin-top: 15px;
}

.count-box {

    background:
        rgba(255,255,255,.10);

    border-radius: 14px;

    padding: 9px 5px;

    text-align: center;
}

.count-number {

    font-size: 25px;

    font-weight: 900;
}

.count-label {

    font-size: 10px;

    color: #cbd5e1;
}


/* =========================================================
   标题
========================================================= */

.section-title {

    font-size: 20px;

    font-weight: 900;

    margin:
        22px 2px
        9px;
}


/* =========================================================
   全程路线
========================================================= */

.route-map {

    height: 245px;

    overflow: hidden;

    border-radius: 18px;

    background: #f0f3f8;

    border:
        1px solid
        var(--line);
}

.route-map svg {

    width: 100%;

    height: 100%;
}

.map-label {

    font-size: 12px;

    font-weight: 700;

    fill: #4b5563;
}

.route-legend {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 9px;
}

.legend {

    font-size: 11px;

    padding:
        4px
        9px;

    border-radius: 999px;

    background: #f3f4f6;
}


/* =========================================================
   每日行程
========================================================= */

.day-header {

    display: flex;

    justify-content: space-between;

    gap: 12px;

    align-items: flex-start;
}

.day-badge {

    display: inline-block;

    padding:
        4px
        9px;

    border-radius: 999px;

    background: var(--blue-light);

    color: #4754d6;

    font-size: 12px;

    font-weight: 800;
}

.day-area {

    margin-top: 5px;

    font-size: 18px;

    font-weight: 900;
}

.day-date {

    margin-top: 2px;

    color: var(--muted);

    font-size: 12px;
}


/* =========================================================
   路线
========================================================= */

.route-line {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    align-items: center;

    margin:
        11px 0;

    font-weight: 800;

    font-size: 14px;
}

.route-arrow {

    color: #9ca3af;
}


/* =========================================================
   普通活动
========================================================= */

.activity {

    display: flex;

    gap: 12px;

    padding:
        9px 0;

    border-bottom:
        1px dashed
        var(--line);
}

.activity:last-child {
    border-bottom: 0;
}

.activity-time {

    width: 82px;

    flex: none;

    font-size: 12px;

    font-weight: 900;
}

.activity-content {

    flex: 1;
}

.activity-title {

    font-size: 14px;

    font-weight: 800;
}

.activity-description {

    margin-top: 2px;

    color: var(--muted);

    font-size: 12px;
}

.google-map {

    display: inline-block;

    margin-top: 3px;

    color: #4653dc;

    font-size: 12px;

    font-weight: 750;
}


/* =========================================================
   航班
========================================================= */

.flight {

    margin:
        10px 0;

    padding: 13px;

    background: #f7f8ff;

    border:
        1px solid
        #dfe4ff;

    border-radius: 17px;
}

.flight-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;
}

.flight-number {

    color: #4652d0;

    font-size: 19px;

    font-weight: 900;
}

.flight-status {

    padding:
        5px 9px;

    border-radius: 999px;

    background: var(--blue);

    color: white;

    font-size: 11px;

    font-weight: 800;
}

.flight-route {

    display: grid;

    grid-template-columns:
        1fr
        65px
        1fr;

    gap: 8px;

    align-items: center;

    margin-top: 10px;
}

.airport strong {

    display: block;

    font-size: 23px;

    font-weight: 900;
}

.airport-name {

    display: block;

    margin-top: 1px;

    color: var(--muted);

    font-size: 11px;
}

.airport-terminal {

    display: inline-block;

    margin-top: 3px;

    padding:
        2px
        6px;

    background: var(--blue-light);

    color: #4754d6;

    border-radius: 6px;

    font-size: 10px;

    font-weight: 800;
}

.flight-time {

    text-align: center;

    font-size: 19px;

    font-weight: 900;
}

.flight-time-label {

    display: block;

    color: var(--muted);

    font-size: 9px;

    font-weight: 500;
}

.flight-arrival {

    margin-top: 9px;

    padding-top: 8px;

    border-top:
        1px solid
        #e5e7eb;

    color: var(--muted);

    font-size: 11px;
}

.flight-actions {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 10px;
}

.btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border: 0;

    border-radius: 11px;

    padding:
        8px
        11px;

    background: var(--blue-light);

    color: #3f4ccc;

    font-size: 12px;

    font-weight: 800;

    cursor: pointer;
}

.btn-gray {

    background: #eef2f7;

    color: #374151;
}


/* =========================================================
   酒店
========================================================= */

.hotel {

    margin-top: 10px;

    padding: 13px;

    border-radius: 16px;

    background: #fbfaf7;

    border:
        1px solid
        #eee7d9;
}

.hotel-name {

    font-size: 15px;

    font-weight: 900;
}

.hotel-info {

    margin-top: 4px;

    color: #6b6255;

    font-size: 12px;
}

.hotel-map {

    display: inline-block;

    margin-top: 5px;

    color: #765f2b;

    font-size: 12px;

    font-weight: 750;
}


/* =========================================================
   备注
========================================================= */

.note {

    margin-top: 11px;

    padding:
        10px
        12px;

    border-left:
        4px solid
        var(--orange);

    border-radius: 10px;

    background: var(--orange-light);

    font-size: 13px;
}

.note-title {

    font-weight: 900;
}

.note ul {

    margin:
        4px 0
        0;

    padding-left: 20px;
}

.note li {

    margin: 3px 0;
}


/* =========================================================
   Footer
========================================================= */

.footer {

    text-align: center;

    color: var(--muted);

    font-size: 11px;

    padding:
        20px 0;
}


/* =========================================================
   手机
========================================================= */

@media(max-width: 640px) {

    .container {
        padding:
            13px
            10px
            45px;
    }

    .title {
        font-size: 27px;
    }

    .count-number {
        font-size: 21px;
    }

    .flight-route {
        grid-template-columns:
            1fr
            50px
            1fr;
    }

    .airport strong {
        font-size: 20px;
    }

    .activity-time {
        width: 72px;
    }
}


/* =========================================================
   深色模式
========================================================= */

@media(prefers-color-scheme: dark) {

    :root {

        --bg: #0b1020;

