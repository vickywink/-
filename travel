/* =========================================================

   时区计算

========================================================= */

function getTimeZoneOffset(

  date,

  timeZone

){

  const parts =

    new Intl.DateTimeFormat(

      "en-US",

      {

        timeZone:timeZone,

        timeZoneName:"longOffset"

      }

    ).formatToParts(date);

  const tz =

    parts.find(function(p){

      return p.type === "timeZoneName";

    })?.value || "GMT+00:00";

  const match =

    tz.match(

      /GMT([+-])(\d{2}):?(\d{2})?/

    );

  if(!match){

    return 0;

  }

  const sign =

    match[1] === "+"

    ? 1

    : -1;

  const hours =

    Number(match[2] || 0);

  const minutes =

    Number(match[3] || 0);

  return sign *

    (hours * 60 + minutes);

}

/* =========================================================

   将指定时区时间转换为 UTC

========================================================= */

function zonedTimeToUTC(

  dateString,

  timeString,

  timeZone

){

  const parts =

    dateString

      .split("-")

      .map(Number);

  const year = parts[0];

  const month = parts[1];

  const day = parts[2];

  const timeParts =

    timeString

      .split(":")

      .map(Number);

  const hour = timeParts[0];

  const minute = timeParts[1];

  const approximate =

    new Date(

      Date.UTC(

        year,

        month - 1,

        day,

        hour,

        minute

      )

    );

  const offset =

    getTimeZoneOffset(

      approximate,

      timeZone

    );

  return new Date(

    approximate.getTime() -

    offset * 60000

  );

}

