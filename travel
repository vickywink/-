/* =========================================================

   飞常准 App

========================================================= */

const VARIFLIGHT_APP =

"https://apps.apple.com/cn/app/%E9%A3%9E%E5%B8%B8%E5%87%86-%E8%88%AA%E7%8F%AD%E5%8A%A8%E6%80%81%E6%9C%BA%E7%A5%A8%E8%B4%AD%E4%B9%B0%E6%9F%A5%E8%AF%A2%E8%BF%BD%E8%B8%AA%E5%80%BC%E6%9C%BA/id498818574";

/* =========================================================

   Google Maps

========================================================= */

function googleMaps(query){

  const url =

    "https://www.google.com/maps/search/?api=1&query=" +

    encodeURIComponent(query);

  window.open(url,"_blank");

}

/* =========================================================

   飞常准

========================================================= */

function openVariflight(flightNumber){

  const appUrl =

    "variflight://flight/" +

    encodeURIComponent(flightNumber);

  const iframe =

    document.createElement("iframe");

  iframe.style.display = "none";

  iframe.src = appUrl;

  document.body.appendChild(iframe);

  setTimeout(function(){

    window.open(

      VARIFLIGHT_APP,

      "_blank"

    );

    iframe.remove();

  },1200);

