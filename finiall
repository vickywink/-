<!DOCTYPE html>
<html lang="zh-CN">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<meta name="theme-color" content="#f5f3ee">

<meta name="apple-mobile-web-app-capable" content="yes">

<meta name="apple-mobile-web-app-status-bar-style" content="default">

<title>法国＋意大利16日旅行手册</title>

<style>

:root{
  --bg:#f5f3ee;
  --card:#ffffff;
  --text:#252525;
  --muted:#777;
  --line:#e7e3dc;
  --soft:#f0ede7;
  --green:#58745d;
  --blue:#54779a;
  --red:#9a5b57;
  --gold:#a08045;
  --shadow:0 8px 30px rgba(0,0,0,.06);
  --radius:20px;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",
  "PingFang SC","Helvetica Neue",Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

button{
  font:inherit;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(1100px,calc(100% - 28px));
  margin:0 auto;
}


/* ==============================
   顶部
============================== */

.hero{
  padding:30px 0 18px;
}

.hero-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
}

.eyebrow{
  font-size:11px;
  letter-spacing:2px;
  color:var(--muted);
  margin-bottom:8px;
}

h1{
  margin:0;
  font-size:30px;
  line-height:1.2;
  letter-spacing:-1px;
}

.subtitle{
  margin-top:10px;
  color:var(--muted);
  font-size:14px;
}

.time-box{
  text-align:right;
  min-width:210px;
}

.time-place{
  font-size:12px;
  font-weight:800;
  color:var(--green);
  margin-bottom:2px;
}

.time-main{
  font-size:22px;
  font-weight:800;
  font-variant-numeric:tabular-nums;
}

.time-small{
  color:var(--muted);
  font-size:12px;
}

.weather-row{
  margin-top:7px;
}

.weather-button{
  display:inline-flex;
  align-items:center;
  gap:5px;
  border:1px solid var(--line);
  background:var(--card);
  color:var(--text);
  border-radius:11px;
  padding:7px 10px;
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  transition:.2s;
}

.weather-button:hover{
  opacity:.75;
}

.weather-button:active{
  opacity:.55;
  transform:scale(.98);
}


/* ==============================
   吃药倒计时
============================== */

.medicine-row{
  margin-top:6px;
}

.medicine-countdown{
  display:inline-flex;
  align-items:center;
  gap:5px;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
  font-variant-numeric:tabular-nums;
}

.medicine-icon{
  font-size:12px;
}

.medicine-time{
  color:var(--text);
  font-weight:800;
  letter-spacing:.2px;
}


/* ==============================
   卡片
============================== */

.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
}

.section{
  margin:18px 0;
}

.section-title{
  font-size:20px;
  font-weight:800;
  margin:28px 0 12px;
}


/* ==============================
   NEXT 倒计时
============================== */

.focus{
  padding:22px;
  overflow:hidden;
  position:relative;
}

.focus-label{
  font-size:11px;
  color:var(--muted);
  letter-spacing:2px;
  margin-bottom:5px;
}

.focus-title{
  font-size:22px;
  font-weight:800;
  line-height:1.35;
}

.focus-desc{
  font-size:13px;
  color:var(--muted);
  margin-top:4px;
}

.countdown{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin-top:20px;
}

.count-box{
  background:var(--soft);
  border-radius:16px;
  padding:14px 5px;
  text-align:center;
}

.count-number{
  font-size:29px;
  line-height:1;
  font-weight:800;
  font-variant-numeric:tabular-nums;
}

.count-unit{
  margin-top:5px;
  font-size:11px;
  color:var(--muted);
}


/* ==============================
   日期导航
============================== */

.day-nav{
  position:sticky;
  top:0;
  z-index:50;
  padding:9px 0;
  background:rgba(245,243,238,.92);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  overflow-x:auto;
}

.day-nav-inner{
  display:flex;
  gap:7px;
  min-width:max-content;
}

.day-nav a{
  padding:7px 12px;
  border-radius:20px;
  background:var(--card);
  border:1px solid var(--line);
  font-size:11px;
  font-weight:700;
}


/* ==============================
   总路线地图
============================== */

.map-card{
  padding:18px;
}

.map-wrap{
  width:100%;
  overflow:hidden;
  border-radius:16px;
  background:#faf8f3;
}

.map-svg{
  display:block;
  width:100%;
  height:auto;
}

.map-label{
  font-size:12px;
  font-weight:700;
}

.map-note{
  margin-top:10px;
  font-size:12px;
  color:var(--muted);
}


/* ==============================
   每日行程
============================== */

.day{
  margin:22px 0;
  overflow:hidden;
  scroll-margin-top:65px;
}

.day-head{
  padding:20px 20px 14px;
  border-bottom:1px solid var(--line);
}

.day-number{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:44px;
  height:28px;
  padding:0 10px;
  border-radius:20px;
  background:#111;
  color:#fff;
  font-size:12px;
  font-weight:800;
  margin-bottom:10px;
}

.day-title{
  font-size:21px;
  font-weight:800;
  line-height:1.35;
}

.day-route{
  margin-top:4px;
  font-size:13px;
  color:var(--muted);
}

.day-local-meta{
  margin-top:9px;
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:6px 9px;
  background:var(--soft);
  border-radius:10px;
  font-size:11px;
  color:var(--muted);
  font-weight:700;
}

.day-body{
  padding:18px 20px 22px;
}


/* ==============================
   活动
============================== */

.activities{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.activity{
  display:flex;
  gap:12px;
  padding:13px 14px;
  border-radius:15px;
  background:var(--soft);
}

.activity-time{
  width:92px;
  flex:none;
  font-size:12px;
  font-weight:700;
  color:var(--muted);
}

.activity-main{
  flex:1;
  font-size:14px;
}

.activity-main strong{
  font-weight:800;
}


/* ==============================
   Google Maps 地点文字
============================== */

.place-link{
  color:var(--text);
  font-weight:800;
  text-decoration:none;
  border-bottom:1px dashed var(--muted);
  transition:.2s;
}

.place-link:hover{
  opacity:.7;
}

.place-link:active{
  opacity:.5;
}

.place-link::after{
  content:" ↗";
  font-size:11px;
  color:var(--muted);
}


/* ==============================
   Google Maps 按钮
============================== */

.maps-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:5px;
  margin-top:8px;
  padding:7px 11px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--card);
  color:var(--text);
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  transition:.2s;
}

.maps-button:hover{
  opacity:.75;
  transform:translateY(-1px);
}

.maps-button:active{
  transform:translateY(0);
  opacity:.6;
}


/* ==============================
   航班
============================== */

.flight{
  margin-top:16px;
  padding:16px;
  border-radius:17px;
  background:#f8f6f1;
  border:1px solid var(--line);
}

.flight-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}

.flight-no{
  font-size:17px;
  font-weight:800;
}

.flight-airline{
  font-size:12px;
  color:var(--muted);
}

.flight-route{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  gap:12px;
  align-items:center;
  margin:16px 0;
}

.airport-time{
  font-size:22px;
  font-weight:800;
  line-height:1;
  font-variant-numeric:tabular-nums;
}

.airport-code{
  font-size:13px;
  font-weight:700;
  margin-top:5px;
}

.airport-city{
  font-size:11px;
  color:var(--muted);
}

.route-arrow{
  color:var(--muted);
  font-size:20px;
}

.flight-info{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px;
}

.info-item{
  background:var(--card);
  padding:10px 12px;
  border-radius:12px;
  border:1px solid var(--line);
}

.info-label{
  font-size:10px;
  color:var(--muted);
  margin-bottom:2px;
}

.info-value{
  font-size:12px;
  font-weight:700;
}

.flight-button{
  width:100%;
  border:0;
  background:#111;
  color:#fff;
  padding:12px;
  border-radius:12px;
  margin-top:10px;
  font-weight:700;
  cursor:pointer;
}


/* ==============================
   酒店
============================== */

.hotel{
  margin-top:16px;
  padding:16px;
  border-radius:17px;
  border:1px solid var(--line);
}

.hotel-name{
  font-size:16px;
  font-weight:800;
  line-height:1.4;
}

.hotel-date{
  margin-top:4px;
  font-size:12px;
  color:var(--muted);
}

.hotel-actions{
  display:flex;
  gap:8px;
  margin-top:12px;
}

.small-button{
  flex:1;
  border:1px solid var(--line);
  background:var(--card);
  color:var(--text);
  border-radius:11px;
  padding:9px;
  font-size:12px;
  font-weight:700;
  cursor:pointer;
}


/* ==============================
   交通
============================== */

.transport{
  margin-top:16px;
  padding:16px;
  border-radius:17px;
  background:#f7f7f5;
  border:1px solid var(--line);
}

.transport-title{
  font-weight:800;
  font-size:14px;
  margin-bottom:10px;
}

.transport-row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:8px 0;
  border-bottom:1px solid var(--line);
  font-size:12px;
}

.transport-row:last-child{
  border-bottom:0;
}

.transport-label{
  color:var(--muted);
}

.transport-value{
  text-align:right;
  font-weight:700;
}


/* ==============================
   备注
============================== */

.note{
  margin-top:16px;
  padding:16px;
  border-left:4px solid var(--gold);
  background:#fbf8ef;
  border-radius:0 14px 14px 0;
}

.note-title{
  font-size:12px;
  font-weight:800;
  margin-bottom:5px;
}

.note-text{
  font-size:13px;
  white-space:pre-line;
}


/* ==============================
   Footer
============================== */

.footer{
  text-align:center;
  color:var(--muted);
  font-size:11px;
  padding:35px 0 50px;
}


/* ==============================
   夜间模式
============================== */

body.dark{
  --bg:#101112;
  --card:#191a1c;
  --text:#f3f3f3;
  --muted:#9c9c9f;
  --line:#303134;
  --soft:#242528;
  --shadow:0 8px 30px rgba(0,0,0,.22);
}

body.dark .day-nav{
  background:rgba(16,17,18,.90);
}

body.dark .map-wrap{
  background:#171819;
}

body.dark .flight,
body.dark .transport{
  background:#202124;
}

body.dark .info-item,
body.dark .small-button,
body.dark .maps-button,
body.dark .weather-button{
  background:#191a1c;
  color:#fff;
}

body.dark .note{
  background:#252219;
}


/* ==============================
   手机
============================== */

@media(max-width:700px){

  .container{
    width:calc(100% - 20px);
  }

  .hero{
    padding-top:24px;
  }

  .hero-top{
    display:block;
  }

  .time-box{
    margin-top:14px;
    text-align:left;
    min-width:0;
  }

  h1{
    font-size:27px;
  }

  .focus{
    padding:18px;
  }

  .focus-title{
    font-size:20px;
  }

  .count-number{
    font-size:25px;
  }

  .day-head,
  .day-body{
    padding-left:15px;
    padding-right:15px;
  }

  .day-title{
    font-size:19px;
  }

  .flight-route{
    gap:8px;
  }

  .airport-time{
    font-size:20px;
  }

  .activity{
    padding:12px;
  }

  .activity-time{
    width:78px;
  }

}


/* ==============================
   小屏
============================== */

@media(max-width:380px){

  .countdown{
    gap:5px;
  }

  .count-number{
    font-size:22px;
  }

  .activity-time{
    width:68px;
    font-size:11px;
  }

  .airport-time{
    font-size:18px;
  }

}

</style>

</head>


