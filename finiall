/* =========================================================
   WMO 天气代码
========================================================= */

function weatherDescription(code){

  if(code === 0){
    return "晴";
  }

  if(code === 1){
    return "基本晴朗";
  }

  if(code === 2){
    return "局部多云";
  }

  if(code === 3){
    return "阴";
  }

  if(code === 45 || code === 48){
    return "雾";
  }

  if(code >= 51 && code <= 55){
    return "毛毛雨";
  }

  if(code === 56 || code === 57){
    return "冻雨";
  }

  if(code >= 61 && code <= 65){
    return "降雨";
  }

  if(code === 66 || code === 67){
    return "冻雨";
  }

  if(code >= 71 && code <= 75){
    return "降雪";
  }

  if(code === 77){
    return "雪粒";
  }

  if(code >= 80 && code <= 82){
    return "阵雨";
  }

  if(code === 85 || code === 86){
    return "阵雪";
  }

  if(code === 95){
    return "雷雨";
  }

  if(code === 96 || code === 99){
    return "雷雨伴冰雹";
  }

  return "天气";

}


/* =========================================================
   天气图标
========================================================= */

function weatherIcon(code){

  if(code === 0){
    return "☀️";
  }

  if(code === 1 || code === 2){
    return "🌤️";
  }

  if(code === 3){
    return "☁️";
  }

  if(code === 45 || code === 48){
    return "🌫️";
  }

  if(code >= 51 && code <= 67){
    return "🌧️";
  }

  if(code >= 71 && code <= 77){
    return "❄️";
  }

  if(code >= 80 && code <= 82){
    return "🌦️";
  }

  if(code >= 85 && code <= 86){
    return "🌨️";
  }

  if(code >= 95){
    return "⛈️";
  }

  return "☁️";

}


/* =========================================================
   天气请求
========================================================= */

function loadWeather(){

  var button =
    document.getElementById(
      "weatherButton"
    );

  var text =
    document.getElementById(
      "weatherText"
    );

  if(!button || !text){
    return;
  }

  var currentDay =
    getCurrentTripDay();

  if(!currentDay){

    text.textContent =
      "暂无天气";

    return;

  }

  var city =
    cityData[currentDay.cityKey];

  if(!city){

    text.textContent =
      "暂无天气";

    return;

  }


  button.onclick =
    function(){

      openAppleWeather(
        city.weatherQuery
      );

    };


  text.textContent =
    city.name +
    " · 天气加载中…";


  var url =
    "https://api.open-meteo.com/v1/forecast" +
    "?latitude=" +
    encodeURIComponent(city.latitude) +
    "&longitude=" +
    encodeURIComponent(city.longitude) +
    "&daily=weather_code,temperature_2m_max,temperature_2m_min" +
    "&timezone=" +
    encodeURIComponent(city.timezone) +
    "&forecast_days=16";


  fetch(url)

    .then(function(response){

      if(!response.ok){

        throw new Error(
          "weather request failed"
        );

      }

      return response.json();

    })

    .then(function(data){

      if(
        !data ||
        !data.daily ||
        !data.daily.time
      ){

        throw new Error(
          "weather data unavailable"
        );

      }


      var targetDate =
        currentDay.startDate;


      var index =
        data.daily.time.indexOf(
          targetDate
        );


      if(index < 0){

        text.textContent =
          city.name +
          " · 暂无预报";

        return;

      }


      var code =
        data.daily.weather_code[index];

      var max =
        data.daily.temperature_2m_max[index];

      var min =
        data.daily.temperature_2m_min[index];


      if(
        typeof code !== "number"
      ){

        text.textContent =
          city.name +
          " · 暂无预报";

        return;

      }


      var icon =
        weatherIcon(code);

      var description =
        weatherDescription(code);


      var temperatureText =
        "";


      if(
        typeof max === "number" &&
        typeof min === "number"
      ){

        temperatureText =
          " · " +
          Math.round(max) +
          "°C / " +
          Math.round(min) +
          "°C";

      }


      text.textContent =
        icon +
        " " +
        city.name +
        " · " +
        description +
        temperatureText;

    })

    .catch(function(){

      text.textContent =
        city.name +
        " · 暂无预报";

    });

}


/* =========================================================
   吃药倒计时
   北京时间 2026-09-06 09:00 开始
   每24小时循环一次
========================================================= */

var MEDICINE_START_TIME =
  Date.UTC(
    2026,
    8,
    6,
    1,
    0,
    0
  );


function updateMedicineCountdown(){

  var element =
    document.getElementById(
      "medicineCountdown"
    );

  if(!element){
    return;
  }


  var now =
    Date.now();


  /*
    北京时间 2026-09-06 09:00
    对应 UTC 2026-09-06 01:00
  */

  if(
    now < MEDICINE_START_TIME
  ){

    var before =
      MEDICINE_START_TIME -
      now;


    var beforeTotalSeconds =
      Math.ceil(
        before / 1000
      );


    var beforeHours =
      Math.floor(
        beforeTotalSeconds / 3600
      );


    var beforeMinutes =
      Math.floor(
        (
          beforeTotalSeconds % 3600
        ) / 60
      );


    var beforeSeconds =
      beforeTotalSeconds % 60;


    element.textContent =
      String(beforeHours) +
      ":" +
      String(beforeMinutes).padStart(2,"0") +
      ":" +
      String(beforeSeconds).padStart(2,"0");

    return;

  }


  var elapsed =
    now -
    MEDICINE_START_TIME;


  var cycle =
    24 * 60 * 60 * 1000;


  var remainder =
    elapsed % cycle;


  var remaining =
    cycle -
    remainder;


  /*
    防止极少数情况下显示 24:00:00 之外
  */

  if(
    remaining <= 0 ||
    remaining > cycle
  ){

    remaining =
      cycle;

  }


  var totalSeconds =
    Math.ceil(
      remaining / 1000
    );


  /*
    由于 ceil 的关系，
    最后一秒会显示 00:00:01，
    下一次刷新进入新的24小时周期
  */

  var hours =
    Math.floor(
      totalSeconds / 3600
    );


  var minutes =
    Math.floor(
      (
        totalSeconds % 3600
      ) / 60
    );


  var seconds =
    totalSeconds % 60;


  element.textContent =
    String(hours).padStart(2,"0") +
    ":" +
    String(minutes).padStart(2,"0") +
    ":" +
    String(seconds).padStart(2,"0");

}


