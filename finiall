/* =========================================================
   判断当前应该显示哪一天
========================================================= */

function getCurrentTripDay(){

  var now = new Date();

  var today =
    now.getFullYear() +
    "-" +
    String(now.getMonth()+1).padStart(2,"0") +
    "-" +
    String(now.getDate()).padStart(2,"0");

  var firstDay = days[0];

  var lastDay = days[days.length-1];

  if(today < firstDay.startDate){

    return firstDay;

  }

  for(var i=0;i<days.length;i++){

    var day = days[i];

    if(
      today >= day.startDate &&
      today <= day.endDate
    ){

      return day;

    }

  }

  return lastDay;

}


