    title:"CA1815 北京 → 厦门",
    desc:"9月23日 16:30 · PEK T3 → XMN T4",
    date:"2026-09-23",
    time:"16:30",
    timezone:"Asia/Shanghai"
  }

];


/* =========================================================
   获取时区 UTC offset
========================================================= */

function getTimeZoneOffset(
  date,
  timeZone
){

  try{

    var parts =
      new Intl.DateTimeFormat(
        "en-US",
        {
          timeZone:timeZone,
          timeZoneName:"longOffset"
        }
      ).formatToParts(date);


    var tz =
      "GMT+00:00";


    for(
      var i=0;
      i<parts.length;
      i++
    ){

      if(
        parts[i].type ===
        "timeZoneName"
      ){

        tz =
          parts[i].value;

        break;

      }

    }


    var match =
      tz.match(
        /GMT([+-])(\d{2}):?(\d{2})?/
      );


    if(!match){

      return 0;

    }


    var sign =
      match[1] === "+"
      ? 1
      : -1;


    var hours =
      Number(
        match[2] || 0
      );


    var minutes =
      Number(
        match[3] || 0
      );


    return sign *
      (
        hours * 60 +
        minutes
      );

  }catch(e){

    return 0;

  }

}


/* =========================================================
   指定时区时间 → UTC
========================================================= */

function zonedTimeToUTC(
  dateString,
  timeString,
  timeZone
){

  var dateParts =
    dateString
      .split("-")
      .map(Number);


  var year =
    dateParts[0];

  var month =
    dateParts[1];

  var day =
    dateParts[2];


  var timeParts =
    timeString
      .split(":")
      .map(Number);


  var hour =
    timeParts[0];

  var minute =
    timeParts[1];


  var approximate =
    new Date(
      Date.UTC(
        year,
        month - 1,
        day,
        hour,
        minute
      )
    );


  var offset =
    getTimeZoneOffset(
      approximate,
      timeZone
    );


  return new Date(
    approximate.getTime() -
    offset * 60000
  );

}


/* =========================================================
   NEXT 倒计时
========================================================= */

function updateCountdown(){

  var now =
    new Date();

  var next =
    null;


  for(
    var i=0;
    i<nextEvents.length;
    i++
  ){

    var event =
      nextEvents[i];

    var target =
      zonedTimeToUTC(
        event.date,
        event.time,
        event.timezone
      );


    if(
      target.getTime() >
      now.getTime()
    ){

      next = {
        title:event.title,
        desc:event.desc,
        target:target
      };

      break;

    }

  }


  var titleElement =
    document.getElementById(
      "nextTitle"
    );

  var descElement =
    document.getElementById(
      "nextDesc"
    );

  var daysElement =
    document.getElementById(
      "countDays"
    );

  var hoursElement =
    document.getElementById(
      "countHours"
    );

  var minutesElement =
    document.getElementById(
      "countMinutes"
    );

  var secondsElement =
    document.getElementById(
      "countSeconds"
    );


  if(!next){

    titleElement.textContent =
      "本次行程已经结束";

    descElement.textContent =
      "期待下一次出发 ✈️";

    daysElement.textContent =
      "0";

    hoursElement.textContent =
      "00";

    minutesElement.textContent =
      "00";

    secondsElement.textContent =
      "00";

    return;

  }


  titleElement.textContent =
    next.title;

  descElement.textContent =
    next.desc;


  var diff =
    next.target.getTime() -
    now.getTime();


  var totalSeconds =
    Math.max(
      0,
      Math.floor(
        diff / 1000
      )
    );


  var daysLeft =
    Math.floor(
      totalSeconds / 86400
    );


  var hoursLeft =
    Math.floor(
      (
        totalSeconds % 86400
      ) / 3600
    );


  var minutesLeft =
    Math.floor(
      (
        totalSeconds % 3600
      ) / 60
    );


  var secondsLeft =
    totalSeconds % 60;


  daysElement.textContent =
    String(daysLeft);


  hoursElement.textContent =
    String(hoursLeft)
      .padStart(2,"0");


  minutesElement.textContent =
    String(minutesLeft)
      .padStart(2,"0");


  secondsElement.textContent =
    String(secondsLeft)
      .padStart(2,"0");

}


/* =========================================================
   自动昼夜主题
========================================================= */

function updateTheme(){

  var currentDay =
    getCurrentTripDay();

  if(!currentDay){
    return;
  }

  var city =
    cityData[currentDay.cityKey];

  if(!city){
    return;
  }

  var now =
    new Date();


  var hourText =
    new Intl.DateTimeFormat(
      "en-US",
      {
        timeZone:city.timezone,
        hour:"numeric",
        hour12:false
      }
    ).format(now);


  var hour =
    parseInt(
      hourText,
      10
    );


  if(
    hour >= 6 &&
    hour < 18
  ){

    document.body.classList.remove(
      "dark"
    );

  }else{

    document.body.classList.add(
      "dark"
    );

  }

}


